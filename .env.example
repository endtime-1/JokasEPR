NODE_ENV="development"

# ─── Database ────────────────────────────────────────────────────────────────
# LOCAL DEV: MySQL via docker-compose on port 13306 (run `docker compose up -d`).
# PRODUCTION (Hostinger): Set in the Hostinger env panel using your MySQL credentials.
DATABASE_URL="mysql://jokas:jokas_dev_password@localhost:13306/jokas_erp"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace-with-at-least-32-characters-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-32-characters-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# ─── Server ports & origins ───────────────────────────────────────────────────
API_PORT="4001"
API_PREFIX="api"
API_VERSION="1"
WEB_PORT="3000"
# Comma-separated list of allowed CORS origins (web + storefront)
WEB_ORIGIN="http://localhost:3000,http://localhost:3001"
PORT="3000"

# ─── Public API URLs (consumed by Next.js + Expo) ────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4001/api/v1"
EXPO_PUBLIC_API_URL="http://localhost:4001/api/v1"

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_MAX_MB="10"

# ─── AI / Claude ──────────────────────────────────────────────────────────────
AI_API_KEY=""
AI_MODEL="claude-sonnet-4-5"
AI_MODELS="claude-sonnet-4-5,claude-opus-4-1,claude-haiku-4-5"

# ─── Email / SMTP (required for password resets, notifications) ───────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@jokasfarms.com"
SMTP_PASS=""
SMTP_FROM_NAME="Jokas Farms"
SMTP_FROM_ADDRESS="noreply@jokasfarms.com"

# ─── SMS / Twilio (optional — for SMS alerts) ────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─── WhatsApp (optional — for WhatsApp notifications) ────────────────────────
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM_NUMBER=""

# ─── QuickBooks integration (optional) ───────────────────────────────────────
QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_REDIRECT_URI="https://jokasfarms.com/api/v1/quickbooks/oauth/callback"
QB_ENVIRONMENT="sandbox"
QB_TOKEN_ENCRYPTION_KEY=""
QB_WEBHOOK_VERIFIER_TOKEN=""

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Set ENABLE_SWAGGER=true to expose /api/docs in production (disabled by default)
ENABLE_SWAGGER="false"

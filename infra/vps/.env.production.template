# ============================================================================
# Jokas ERP — VPS production environment
# Copy to  <repo>/.env  and fill in every REPLACE_ value.  Never commit it.
#   cp infra/vps/.env.production.template .env
# Generate secrets with:  openssl rand -hex 64   (JWT)   /   openssl rand -hex 32
# ============================================================================

NODE_ENV="production"

# ── Database (MySQL on this same VPS) ────────────────────────────────────────
# Must match DB_NAME / DB_USER / DB_PASS from infra/vps/setup.sh
DATABASE_URL="mysql://jokas:REPLACE_DB_PASS@localhost:3306/jokas_erp?connection_limit=15&pool_timeout=30"

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="REPLACE_64_HEX"
JWT_REFRESH_SECRET="REPLACE_64_HEX"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# ── API server ──────────────────────────────────────────────────────────────
API_PORT="4001"
API_PREFIX="api"
API_VERSION="1"

# ── CORS / public URLs ──────────────────────────────────────────────────────
WEB_ORIGIN="https://jokasfarms.com"
NEXT_PUBLIC_API_URL="https://jokasfarms.com/api/v1"
EXPO_PUBLIC_API_URL="https://jokasfarms.com/api/v1"

# ── File uploads ────────────────────────────────────────────────────────────
UPLOAD_MAX_MB="20"
UPLOAD_DIR="/opt/jokas/shared/uploads"

# ── First-run setup wizard (POST /setup) ───────────────────────────────────
SETUP_SECRET_TOKEN="REPLACE_32_HEX"

# ── Anthropic AI (Claude) ──────────────────────────────────────────────────
AI_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
AI_MODELS="claude-sonnet-4-6,claude-haiku-4-5-20251001"

# ── Email (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@jokasfarms.com"
SMTP_PASS=""
SMTP_FROM_NAME="Jokas Farms"
SMTP_FROM_ADDRESS="noreply@jokasfarms.com"

# ── Failure alerts (Slack/Discord incoming-webhook URL; blank = disabled) ──
ALERT_WEBHOOK_URL=""

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL="warn"
ENABLE_SWAGGER="false"

# ── Optional integrations ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM_NUMBER=""
QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_REDIRECT_URI="https://jokasfarms.com/api/v1/quickbooks/callback"
QB_ENVIRONMENT="production"
